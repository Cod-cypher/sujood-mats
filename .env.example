# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# DATABASE_URL: PostgreSQL connection string used by Prisma.
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://user:password@localhost:5432/myappdb?schema=public"

# ORDER EMAILS (SMTP): invoice checkout takes no payment. It emails the customer that an invoice
# will follow, and notifies sales that one is needed. If these are unset, orders are
# still saved but no email is sent (the server logs a warning).
SMTP_HOST="smtp.example.com"
SMTP_PORT="465"
# "true" for implicit TLS (port 465), "false" for STARTTLS (port 587).
SMTP_SECURE="true"
# Mailbox the emails are sent from, and its password.
SALES_EMAIL="sales@sujoodmats.com"
SALES_PASSWORD="MY_MAILBOX_PASSWORD"
# Who receives the "new order" notification (comma-separated). TO defaults to
# sales@sujoodmats.com; CC has no default, so set it here to get a copy.
# ORDER_NOTIFY_TO="sales@sujoodmats.com"
ORDER_NOTIFY_CC="you@example.com"

# PAYPAL (optional): adds a "Pay with PayPal" button to checkout, alongside pay-by-invoice.
# While neither PayPal nor Stripe is set, checkout is invoice-only. Create a REST app at
# https://developer.paypal.com/dashboard/applications to get the two keys. Sandbox and
# live have DIFFERENT keys: switching PAYPAL_BASE_URL alone is not enough.
# PAYPAL_CLIENT_ID="MY_PAYPAL_CLIENT_ID"
# PAYPAL_SECRET_KEY="MY_PAYPAL_SECRET"
# Sandbox: https://api-m.sandbox.paypal.com   Live: https://api-m.paypal.com
# PAYPAL_BASE_URL="https://api-m.sandbox.paypal.com"

# STRIPE (optional): adds card payment (with Apple Pay / Google Pay) inside the checkout.
# Needs both keys, from the same mode. Test and live have DIFFERENT keys:
# https://dashboard.stripe.com/apikeys
# STRIPE_SECRET_KEY="sk_test_..."
# STRIPE_PUBLISHABLE_KEY="pk_test_..."
# Recommended in production: a webhook, so an order is marked paid even if the buyer's browser
# closes the moment their card goes through. In the Stripe dashboard add an endpoint for
# https://YOUR_DOMAIN/api/payments/stripe/webhook with the events payment_intent.succeeded and
# payment_intent.processing, then paste its signing secret here.
# STRIPE_WEBHOOK_SECRET="whsec_..."

# ADMIN_TOKEN: a long random string. GET /api/orders and /api/analytics/* expose customer
# data, so they only answer requests sent with "Authorization: Bearer <ADMIN_TOKEN>".
# While this is unset those endpoints return 404.
# ADMIN_TOKEN="MY_LONG_RANDOM_STRING"

# CORS_ORIGIN: only needed if the frontend is served from a DIFFERENT origin than
# this API (e.g. GitHub Pages). For the single-server setup (frontend + API on one
# domain) leave this unset. Comma-separated list, e.g.
# CORS_ORIGIN="https://sujoodmats.com,https://www.sujoodmats.com"

# VITE_API_URL: only for a split deploy — base URL of the backend, baked into the
# frontend at build time. Leave unset when frontend + API share one origin.
# VITE_API_URL="https://api.sujoodmats.com"
